  /** Export mode shapes by sweeping a CutPoint3D across the ruler length. */
  private static void exportModeShapesData(Model model, String filename,
                                            int numModes, int nPoints) {
    String dtag = "tmpMSds";
    String etag = "tmpMSev";
    try {
      removeDataset(model, dtag);
      removeNumerical(model, etag);

      model.result().dataset().create(dtag, "CutPoint3D");
      model.result().dataset(dtag).set("data", "dsetEig");
      model.result().dataset(dtag).set("pointy", "0");
      model.result().dataset(dtag).set("pointz", "0");

      model.result().numerical().create(etag, "EvalPoint");
      model.result().numerical(etag).set("data", dtag);
      model.result().numerical(etag).set("expr", new String[]{"w"});

      double[][] values = new double[nPoints][numModes];
      for (int i = 0; i < nPoints; i++) {
        double s = (double) i / (double) (nPoints - 1);
        model.result().dataset(dtag).set("pointx",
            String.format(Locale.US, "%.16g*L_free", s));
        double[][] raw = model.result().numerical(etag).getReal();
        double[] row;
        if (raw.length == 1) {
          row = raw[0];
        } else if (raw.length > 0 && raw[0].length == 1) {
          row = new double[raw.length];
          for (int k = 0; k < raw.length; k++) row[k] = raw[k][0];
        } else if (raw.length > 0) {
          row = raw[0];
        } else {
          row = new double[0];
        }
        int avail = Math.min(numModes, row.length);
        for (int k = 0; k < avail; k++) values[i][k] = row[k];
      }

      removeNumerical(model, etag);
      removeDataset(model, dtag);

      // Build header dynamically based on numModes
      StringBuilder hdr = new StringBuilder("% x_over_L");
      for (int k = 1; k <= numModes; k++) hdr.append(",w_mode").append(k);

      String[][] out = new String[nPoints][numModes + 1];
      for (int i = 0; i < nPoints; i++) {
        out[i][0] = String.format(Locale.US, "%.10e", (double) i / (double) (nPoints - 1));
        for (int k = 0; k < numModes; k++) {
          out[i][k + 1] = String.format(Locale.US, "%.10e", values[i][k]);
        }
      }
      printCsv(filename, hdr.toString(), out);
    } catch (Exception ex) {
      System.err.println(filename + " FAILED: " + ex.getMessage());
      removeNumerical(model, etag);
      removeDataset(model, dtag);
    }
  }

  /** Export microphone pressure at 10 log-spaced distances (dense near, sparse far)
   *  from ruler surface to air boundary. Follows 1/r spherical spreading physics. */
  private static void exportMicSweepData(Model model) {
    int nPoints = 10;
    double dMin = 0.02;  // 2 cm minimum
    double dMax = 0.12;  // fallback max
    try {
      double airR = model.param().evaluate("air_radius");
      double mX = model.param().evaluate("mic_x");
      double mY = model.param().evaluate("mic_y");
      double halfH = model.param().evaluate("h_ruler");
      // Max mic_z inside sphere with 3 mm margin from boundary
      double maxZ = Math.sqrt(Math.max(0, airR * airR - mX * mX - mY * mY)) - 0.003;
      double maxDist = maxZ - halfH;
      if (maxDist > dMin + 0.01) {
        dMax = maxDist;
      }
    } catch (Exception ex) {
      System.err.println("mic sweep: failed to compute dynamic range, using fallback 0.02-0.12m: " + ex.getMessage());
    }
    // Log-spaced: d_i = dMin * (dMax/dMin)^((i-1)/(n-1))
    double logRatio = Math.log(dMax / dMin) / (double)(nPoints - 1);
    StringBuilder meta = new StringBuilder("% sweep_index,distance_from_surface_m,mic_z_expr\n");
    for (int i = 0; i < nPoints; i++) {
      double dist = dMin * Math.exp(logRatio * i);
      String idx = String.format(Locale.US, "%02d", i + 1);
      String distStr = String.format(Locale.US, "%.4f", dist);
      String zExpr = "h_ruler/2+" + distStr + "[m]";
      String tag = "cptMicSw" + idx;
      String fname = "mic_pressure_timeseries_sweep_" + idx + ".csv";
      meta.append(idx).append(",").append(distStr).append(",").append(zExpr).append("\n");
      try {
        ensureCutPoint(model, tag, "dsetAirTime", "mic_x", "mic_y", zExpr);
        exportPointData(model, tag, new String[]{"t","p"}, fname, "% t_s,p_pa");
      } catch (Exception ex) {
        System.err.println("mic sweep " + fname + " FAILED: " + ex.getMessage());
        removeNumerical(model, "tmpPD_" + tag);
        try { model.result().dataset().remove(tag); } catch (Exception ignored) {}
      }
    }
    // Export metadata
    System.out.println("__CSV__mic_sweep_distances.csv");
    System.out.print(meta.toString().trim());
    System.out.println();
    System.out.println("__CSV_END__");
  }

  private static void removeNumerical(Model model, String tag) {
    try { model.result().numerical().remove(tag); } catch (Exception ex) {}
  }

  private static void removeDataset(Model model, String tag) {
    try { model.result().dataset().remove(tag); } catch (Exception ex) {}
  }
}
