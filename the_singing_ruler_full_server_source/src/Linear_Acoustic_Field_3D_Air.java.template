  // ============================================================
  //  CSV export via stdout markers (bypasses Java Security Manager)
  //  Python run_case.py captures __CSV__filename / __CSV_END__
  // ============================================================

  /** Print CSV data to stdout with markers for Python to capture. */
  private static void printCsv(String filename, String commentedHeader, String[][] data) {
    System.out.println("__CSV__" + filename);
    if (commentedHeader != null && commentedHeader.length() > 0) {
      System.out.println(commentedHeader);
    }
    if (data != null) {
      for (int i = 0; i < data.length; i++) {
        StringBuilder sb = new StringBuilder();
        for (int j = 0; j < data[i].length; j++) {
          if (j > 0) sb.append(",");
          sb.append(data[i][j]);
        }
        System.out.println(sb.toString());
      }
    }
    System.out.println("__CSV_END__");
  }

  private static void exportAllData(Model model) {
    try {
      ensureDataset(model, "dsetEig", "sol1");
      ensureDataset(model, "dsetStructTime", "sol2");
      ensureDataset(model, "dsetAirTime", "sol3");
      ensureCutPoint(model, "cptStruct", "dsetStructTime", "L_free-0.5*h_ruler", "0", "0");
      ensureCutPoint(model, "cptTip", "dsetStructTime", "L_free", "0", "0");
      ensureCutPoint(model, "cptMic", "dsetAirTime", "mic_x", "mic_y", "mic_z");
    } catch (Exception ex) {
      System.err.println("Dataset/cutpoint setup error: " + ex.getMessage());
      return;
    }

    exportFrequencies(model);
    exportPointData(model, "cptStruct", new String[]{"t","w"}, "structure_probe_timeseries.csv", "% t_s,uz_m");
    exportPointData(model, "cptTip", new String[]{"t","w"}, "tip_timeseries.csv", "% t_s,w_m");
    exportPointData(model, "cptMic", new String[]{"t","p"}, "mic_pressure_timeseries.csv", "% t_s,p_pa");
    exportMicSweepData(model);
    exportGlobalData(model, "dsetStructTime", new String[]{"t","force_z_total"}, "impact_force_timeseries.csv", "% t_s,force_z_N");
    exportModeShapesData(model, "mode_shapes.csv", 6, __MODE_POINTS__);
  }

  /** Ensure a solution dataset exists. */
  private static void ensureDataset(Model model, String tag, String solutionTag) {
    try { model.result().dataset(tag); } catch (Exception ex) {
      model.result().dataset().create(tag, "Solution");
    }
    model.result().dataset(tag).set("solution", solutionTag);
  }

  /** Ensure a CutPoint3D dataset exists. */
  private static void ensureCutPoint(Model model, String tag, String dataTag,
                                     String px, String py, String pz) {
    try { model.result().dataset(tag); } catch (Exception ex) {
      model.result().dataset().create(tag, "CutPoint3D");
    }
    model.result().dataset(tag).set("data", dataTag);
    model.result().dataset(tag).set("pointx", px);
    model.result().dataset(tag).set("pointy", py);
    model.result().dataset(tag).set("pointz", pz);
  }

  /** Transpose double[][] */
  private static double[][] transpose(double[][] raw) {
    int rows = raw.length;
    int cols = raw[0].length;
    double[][] t = new double[cols][rows];
    for (int i = 0; i < rows; i++)
      for (int j = 0; j < cols; j++)
        t[j][i] = raw[i][j];
    return t;
  }

  /** Format double[][] data into String[][] with 10-digit scientific notation. */
  private static String[][] formatMatrix(double[][] data) {
    int rows = data.length;
    int cols = data[0].length;
    String[][] out = new String[rows][cols];
    for (int i = 0; i < rows; i++)
      for (int j = 0; j < cols; j++)
        out[i][j] = String.format(Locale.US, "%.10e", data[i][j]);
    return out;
  }

  /** Normalize getReal() output: ensure result has expectedCols columns (row per expression). */
  private static double[][] normalizeCols(double[][] raw, int expectedCols) {
    if (raw == null || raw.length == 0) return new double[expectedCols][0];
    if (raw.length == expectedCols) return raw;
    if (raw[0].length == expectedCols) return transpose(raw);
    throw new RuntimeException("Unexpected shape: " + raw.length + "x" + raw[0].length
        + " expected " + expectedCols + " cols");
  }

  // --- extraction + stdout printing ---

  /** Export frequencies from eigenfrequency study. */
  private static void exportFrequencies(Model model) {
    String tag = "tmpFreq";
    try {
      removeNumerical(model, tag);
      model.result().numerical().create(tag, "EvalGlobal");
      model.result().numerical(tag).set("data", "dsetEig");
      model.result().numerical(tag).set("expr", new String[]{"freq"});
      double[][] raw = model.result().numerical(tag).getReal();
      removeNumerical(model, tag);

      double[] freq;
      if (raw.length == 1) { freq = raw[0]; }
      else {
        freq = new double[raw.length];
        for (int i = 0; i < raw.length; i++) freq[i] = raw[i][0];
      }

      String[][] out = new String[freq.length][2];
      for (int i = 0; i < freq.length; i++) {
        out[i][0] = String.valueOf(i + 1);
        out[i][1] = String.format(Locale.US, "%.6f", freq[i]);
      }
      printCsv("frequencies.csv", "% mode,freq_hz", out);
    } catch (Exception ex) {
      System.err.println("frequencies.csv FAILED: " + ex.getMessage());
      removeNumerical(model, tag);
    }
  }

  /** Export point-evaluated timeseries data (structure probe, mic, tip). */
  private static void exportPointData(Model model, String datasetTag,
                                       String[] exprs, String filename, String commentedHeader) {
    String tag = "tmpPD_" + System.nanoTime();
    try {
      removeNumerical(model, tag);
      model.result().numerical().create(tag, "EvalPoint");
      model.result().numerical(tag).set("data", datasetTag);
      model.result().numerical(tag).set("expr", exprs);
      double[][] raw = model.result().numerical(tag).getReal();
      removeNumerical(model, tag);

      double[][] normed = normalizeCols(raw, exprs.length);
      String[][] out = formatMatrix(transpose(normed));
      printCsv(filename, commentedHeader, out);
    } catch (Exception ex) {
      System.err.println(filename + " FAILED: " + ex.getMessage());
      removeNumerical(model, tag);
    }
  }

  /** Export global-evaluated timeseries data (impact force). */
  private static void exportGlobalData(Model model, String datasetTag,
                                        String[] exprs, String filename, String commentedHeader) {
    String tag = "tmpGD_" + System.nanoTime();
